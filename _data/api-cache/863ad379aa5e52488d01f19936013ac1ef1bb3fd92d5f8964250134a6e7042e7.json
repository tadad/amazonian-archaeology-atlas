{"continue": {"elcontinue": "1116850303", "continue": "||extracts|info|pageprops|coordinates"}, "query": {"pages": [{"pageid": 82004855, "ns": 0, "title": "2026 in paleontology", "extract": "Paleontology or palaeontology is the study of prehistoric life forms on Earth through the examination of plant and animal fossils. This includes the study of body fossils, tracks (ichnites), burrows, cast-off parts, fossilised feces (coprolites), palynomorphs and chemical residues. Because humans have encountered fossils for millennia, paleontology has a long history both before and after becoming formalized as a science. This article records significant discoveries and events related to paleontology that occurred or were published in the year 2026.", "contentmodel": "wikitext", "pagelanguage": "en", "pagelanguagehtmlcode": "en", "pagelanguagedir": "ltr", "touched": "2026-08-06T18:07:39Z", "lastrevid": 1367962621, "length": 294134, "fullurl": "https://en.wikipedia.org/wiki/2026_in_paleontology", "editurl": "https://en.wikipedia.org/w/index.php?title=2026_in_paleontology&action=edit", "canonicalurl": "https://en.wikipedia.org/wiki/2026_in_paleontology", "pageprops": {"wikibase_item": "Q138313422"}, "extlinks": [{"url": "https://search.worldcat.org/oclc/46769716"}, {"url": "https://doi.org/10.1093%2Fzoolinnean%2Fzlaf183"}, {"url": "https://doi.org/10.1017%2Fpab.2025.10083"}, {"url": "https://doi.org/10.1016%2Fj.precamres.2025.107992"}, {"url": "https://doi.org/10.1017%2FS0016756825100459"}, {"url": "https://doi.org/10.1002%2Far.70112"}, {"url": "https://doi.org/10.1126%2Fsciadv.adx1754"}, {"url": "https://doi.org/10.1016%2Fj.isci.2026.114634"}, {"url": "https://doi.org/10.1127%2Fnjgpa%2F1296"}, {"url": "https://doi.org/10.1016%2Fj.cub.2025.11.065"}, {"url": "https://doi.org/10.3389%2Ffevo.2025.1736160"}, {"url": "https://doi.org/10.1016%2Fj.revpalbo.2026.105501"}, {"url": "https://doi.org/10.1016%2Fj.palwor.2026.201068"}, {"url": "https://doi.org/10.1093%2Fzoolinnean%2Fzlaf195"}, 